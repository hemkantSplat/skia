import("//gn/skia.gni")

# A single archive includes Skia and its static dependencies for the C consumer.
static_library("cfsk") {
  complete_static_lib = true
  public = [ "cfsk.h" ]
  sources = [
    "../../tools/graphite/dawn/GraphiteDawnToggles.cpp",
    "../../tools/graphite/GraphiteToolUtils.cpp",
    "cfsk_core.cpp",
    "cfsk_coverage.cpp",
    "cfsk_effects.cpp",
    "cfsk_graphite.cpp",
    "cfsk_internal.h",
    "cfsk_mesh.cpp",
    "cfsk_ordinals.cpp",
    "cfsk_paragraph.cpp",
    "cfsk_paths.cpp",
    "cfsk_picture.cpp",
    "cfsk_picture_resources.cpp",
    "cfsk_text.cpp",
    "cfsk_unsupported.cpp",
  ]
  include_dirs = [ "../.." ]
  deps = [
    "//:pathops",
    "//:skia",
    "//third_party/dawn",
    "//modules/skparagraph",
    "//modules/skshaper",
    "//modules/skunicode",
  ]
}
